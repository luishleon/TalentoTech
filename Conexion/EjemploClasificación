{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOWJUBbfz2e6T4A5vE5aLRM"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":3,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n-AyIusGWF3i","executionInfo":{"status":"ok","timestamp":1780690581759,"user_tz":300,"elapsed":7,"user":{"displayName":"Fashion Valery Store","userId":"11160824411631280678"}},"outputId":"ccc71063-0b52-419e-db96-4969022be6e3"},"outputs":[{"output_type":"stream","name":"stdout","text":["El correo 'Haz sido el ganador de una camioneta Mazda CX30' es: No Spam\n"]}],"source":["# Acá clasificamos correos solo con 2 palabras clave. Es binaria: 1=Spam, 0=No Spam.\n","\n","from sklearn.naive_bayes import MultinomialNB\n","from sklearn.feature_extraction.text import CountVectorizer\n","\n","# 1. Datos: correos ya etiquetados\n","correos = [\n","    \"gana dinero gratis ahora\", # Spam\n","    \"reunión mañana a las 3pm\", # No Spam\n","    \"oferta exclusiva dinero ya\", # Spam\n","    \"te envío el reporte adjunto\" # No Spam\n","    \"Haz sido el ganador de una camioneta Mazda CX30\" #Spam\n","]\n","etiquetas = [1, 0, 1, 0, 1] # 1=Spam, 0=No Spam\n","\n","# 2. Convertimos texto a números: contamos palabras\n","vectorizer = CountVectorizer()\n","X = vectorizer.fit_transform(correos)\n","\n","# 3. Entrenamos Naive Bayes, muy bueno para texto\n","modelo = MultinomialNB()\n","modelo.fit(X, etiquetas)\n","\n","# 4. Clasificamos un correo nuevo\n","correo_nuevo = [\"Haz sido el ganador de una camioneta Mazda CX30\"]\n","X_nuevo = vectorizer.transform(correo_nuevo)\n","prediccion = modelo.predict(X_nuevo)\n","\n","resultado = \"Spam\" if prediccion[0] == 1 else \"No Spam\"\n","print(f\"El correo '{correo_nuevo[0]}' es: {resultado}\") # Resultado: Spam"]}]}